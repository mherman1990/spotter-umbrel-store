{
  "name": "scout",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only single-name equity watch agent: deterministic rules, alert budget, and a local API for the owner's agent. Packaged for Umbrel.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli.ts",
    "guard:orders": "node scripts/guard-no-orders.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "better-sqlite3": "13.1.1",
    "fast-xml-parser": "5.12.0",
    "node-cron": "4.6.0",
    "pino": "10.4.0",
    "ws": "8.22.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "imapflow": "2.11.0",
    "mailparser": "3.14.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
