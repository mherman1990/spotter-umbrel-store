# NAMES ONLY. Copy to /data/secrets/scout.env, fill in values, chmod 600. Never commit the real file.
# Closed allowlist: any other key in the file is ignored (and reported by name in `scout doctor`).
# A non-empty environment variable of the same name overrides the file (local development convenience).

# REQUIRED for SEC calls: contact included in the SEC User-Agent (no default).
SCOUT_SEC_CONTACT=

# Schwab developer app (owner registers it; see docs/RUNBOOK.md). Redirect must be https and match exactly.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=

# Anthropic API (triage, synthesis, earnings extraction). Without it Scout runs rules-only.
ANTHROPIC_API_KEY=

# OpenClaw / Mayer hook: dedicated hooks.token (NOT the gateway token). URL overrides coverage.yaml.
OPENCLAW_HOOK_TOKEN=
OPENCLAW_HOOK_URL=

# ntfy fallback notifier. Scout publishes JSON to NTFY_URL with the topic in the BODY (never in the URL path).
# On a public server the topic IS the credential: pick a long random one.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# FRED (macro context).
FRED_API_KEY=

# FINRA Query API (optional; otherwise the public-file fallback is used).
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=

# Optional newsletter inbox (IMAP).
IMAP_HOST=
IMAP_USER=
IMAP_PASS=

# Optional extra salt for hashing local API tokens.
SCOUT_API_TOKEN_PEPPER=
